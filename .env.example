# UltraDashboard environment configuration
# Copy this file to `.env.local` for local development or `.env` for production.
# All values listed here are referenced by the spec; do not commit real secrets.

# Postgres connection string for the dashboard-owned database.
DATABASE_URL=postgres://ultradash:ultradash@localhost:5432/ultradash

# Public base URL the dashboard is served from (used for canonical links / OG).
ULTRADASHBOARD_BASE_URL=http://localhost:3000

# Path INSIDE the container to OmniRoute's read-only SQLite mirror.
# docker-compose mounts ${OMNIROUTE_SQLITE_HOST_PATH} -> this target read-only.
OMNIROUTE_SQLITE_PATH=/var/omniroute/storage.sqlite

# Path ON THE HOST to the SQLite snapshot that gets bind-mounted into the
# container. OmniRoute's live DB uses WAL journaling, which requires write
# access to the directory — so we mount a periodically-refreshed snapshot
# instead. The snapshot is produced by `scripts/deploy/omniroute_snapshot.sh`
# (typically every 60 s via `omniroute-snapshot.timer`).
OMNIROUTE_SQLITE_HOST_PATH=/root/.omniroute-snapshot/storage.sqlite

# User-facing endpoint reference shown on the OmniRoute page.
OMNIROUTE_DISPLAY_ENDPOINT=https://omniroute.internal.example

# Tunnel information rendered into the OmniRoute tunnel info card.
# Stored as a JSON blob so deployment can describe host / endpoint / notes.
# Example:
# {"host":"vps.example","local":"127.0.0.1:20128","remote":"omniroute.internal","notes":"SSH tunnel via bastion"}
OMNIROUTE_TUNNEL_INFO_JSON={"host":"","local":"","remote":"","notes":""}

# How often the OmniRoute sync runner should execute.
# Accepts either a cron expression or a duration like `1h`, `30m`.
SYNC_CRON_OR_INTERVAL=1h

# Vaultwarden web URL used by operators and diagnostics.
VAULTWARDEN_BASE_URL=https://127.0.0.1:1455

# Secret bridge mode. Current implementation supports `bw-serve`.
VAULTWARDEN_INTERNAL_ACCESS_MODE=bw-serve

# Bitwarden CLI HTTP bridge.
# Local development uses the SSH tunnel on localhost.
# Docker on the VPS should point to the host relay, for example:
# BW_SERVE_URL=http://host.docker.internal:18087
BW_SERVE_URL=http://127.0.0.1:8087

# Optional fixture item id used for smoke-test routing and demos.
VAULTWARDEN_TEST_ITEM_ID=

# Optional organization metadata once Vaultwarden collections are created.
VAULTWARDEN_ORG_ID=
VAULTWARDEN_COLLECTION_IDS=

# Default UI locale for the bilingual shell. One of: ru, en.
DEFAULT_LOCALE=ru
